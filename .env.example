# Plantilla de variables de entorno.
# Copia este archivo como `.env` en la raíz del repositorio y completa los valores.
# NUNCA subas el archivo `.env` al repositorio (ya está en .gitignore).

# --- Servidor NestJS ---
PORT=3000

# --- Base de datos (PostgreSQL en Docker) ---
# Docker Compose usa estas mismas variables para crear la base de datos.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecoruta
DB_PASSWORD=cambia_esta_clave
DB_NAME=ecoruta
# true: TypeORM crea/ajusta las tablas desde las entities (solo desarrollo).
DB_SYNCHRONIZE=true

# --- Agente de IA (se usará más adelante) ---
# Valores posibles: gemini | groq | mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Pagos Wompi sandbox (se usará más adelante) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
