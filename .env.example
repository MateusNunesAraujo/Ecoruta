# Plantilla de variables de entorno.
# Copia este archivo como `.env` en la raíz del repositorio y completa los valores.
# NUNCA subas el archivo `.env` al repositorio (ya está en .gitignore).

# --- Servidor NestJS ---
PORT=3000

# --- Base de datos (PostgreSQL en Docker) ---
# Docker Compose usa estas mismas variables para crear la base de datos.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecoruta
DB_PASSWORD=cambia_esta_clave
DB_NAME=ecoruta
# true: TypeORM crea/ajusta las tablas desde las entities (solo desarrollo).
DB_SYNCHRONIZE=true

# --- Agente de IA ---
# gemini: principal (nivel gratuito; Google usa los datos para entrenar).
# groq:   respaldo. Si hay clave de ambos, el otro se usa si el primero falla.
# mock:   sin red ni cuota, para desarrollar.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
# Opcionales (si se dejan vacíos se usan estos por defecto):
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# --- Pagos Wompi sandbox (se usará más adelante) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
